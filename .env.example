# =====================================================================
# Lexxus — customer storefront env
# Copy to .env.local for local dev. Never commit .env.local.
# =====================================================================

# Backend API base URL (include /api suffix).
NEXT_PUBLIC_API_URL=http://localhost:5050/api

# Public site URL — used for SEO canonicals + OG absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare CDN domain for public asset previews (optional in dev).
NEXT_PUBLIC_CDN_DOMAIN=

# Sentry — leave blank in dev. When set, components/SentryInit.tsx
# dynamically imports @sentry/nextjs and initialises the SDK. Install
# it first: `npm install @sentry/nextjs`.
NEXT_PUBLIC_SENTRY_DSN=
